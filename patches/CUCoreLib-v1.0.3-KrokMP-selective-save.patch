         [HarmonyPatch("SaveGame")]
         [HarmonyPostfix]
         private static void SaveGame_Postfix()
         {
+            // KrokMP serializes each player separately. SaveCoordinator is single-player scoped
+            // and always captures PlayerCamera.main.body, so it must not append that payload here.
