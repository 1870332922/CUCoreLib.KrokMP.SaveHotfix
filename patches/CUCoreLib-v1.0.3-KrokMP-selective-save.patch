+            return Type.GetType("KrokoshaCasualtiesMP.KrokoshaScavMultiplayer, KrokoshaCasualtiesMP", false) != null ||
+                   Type.GetType("KrokoshaCasualtiesMP.GOSyncPacket, KrokoshaCasualtiesMP", false) != null;
